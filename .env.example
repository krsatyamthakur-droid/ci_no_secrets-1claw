# Copy this file to `.env` and fill in ONLY the agent API key.
# `.env` is gitignored and is never committed, never printed, never shared.
#
# The agent API key (starts with `ocv_`) was created by `npx @1claw/cli setup`
# and stored in your AI client MCP configs. Paste that value here.
# This is the ONLY secret that lives on this machine.
ONECLAW_AGENT_API_KEY=

# Optional: pin a specific vault. If omitted, the agent uses its first vault.
# ONECLAW_VAULT_ID=

# Path of the demo secret inside the vault (NOT the secret's value).
# `setup` creates `examples/hello` automatically — we reuse it.
DEMO_SECRET_PATH=examples/hello

# Mock "deploy" endpoint the agent authenticates against to prove it got the key.
# Default is a public echo endpoint; swap for your own to make it a real deploy.
DEPLOY_URL=https://httpbin.org/bearer

# 1Claw API base URL (default is fine).
ONECLAW_API_URL=https://api.1claw.co
